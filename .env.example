# Copy this file to .env (same folder) and fill in what you use. .env is git-ignored: never commit or paste it anywhere.

# Access key for opening the dashboard through a tunnel link (ngrok / Cloudflare). Create with: openssl rand -hex 16
TUNED_KEY=

# Deep research (TradingAgents) with OpenAI. Create an API key in your OpenAI account (separate from a ChatGPT subscription, billed per use).
OPENAI_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai
# Deeper model for the debates and decisions, cheaper model for the rest (these are TradingAgents' own defaults)
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4-mini
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# Cheaper still: put gpt-5.4-mini on both lines above.
# Fewer debate rounds = faster and cheaper
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Other providers instead of OpenAI (set the provider line and one key): anthropic with ANTHROPIC_API_KEY, google with GOOGLE_API_KEY
